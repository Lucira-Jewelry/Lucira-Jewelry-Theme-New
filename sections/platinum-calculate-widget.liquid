    max-width: 56ch;
    font-size: 1rem;
    line-height: 1.5;
  }

  .platinum-rate-page__table-wrap {
    overflow-x: auto;
  }

  .platinum-rate-page__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 680px;
  }

  .platinum-rate-page__table th,
  .platinum-rate-page__table td {
    padding: 0.95rem 1rem;
    border-bottom: 1px solid rgba(25, 25, 25, 0.1);
    text-align: left;
    white-space: nowrap;
  }

  .platinum-rate-page__table thead th {
    font-size: 0.85rem;
