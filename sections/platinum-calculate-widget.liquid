<div class="platinum-widget-section">
  <div class="page-width">
    <div class="wrapper-platinum">
      <div class="platinum-cta-block" style="display:flex;">
      <h1>Todays Platinum rate in {{ page.metafields.custom.city_name }}</h1>
      <button class="platinum-rate-flip-cta" id="flipTrigger">Why Invest In Platinum?</button>
      </div>
      <!-- WRAP platinum-widget__box in a flip container -->
      <div class="platinum-flip-wrapper">
        <div class="platinum-flip-inner" id="platinumFlipInner">

          <!-- FRONT FACE (existing content) -->
          <div class="platinum-flip-front platinum-widget__box">
            <div class="platinum-widget__block platinum-widget__block--today">
              <p class="platinum-widget__label">Platinum Rate: </span>Pt950</p>
              <p class="platinum-widget__price">
                <span class="platinum-unit"></span>{{ section.settings.rate_today -}}
                <span class="platinum-widget__unit">/10 gm</span>
              </p>
            </div>
            <div class="platinum-widget__divider"></div>
            <div class="platinum-widget__block platinum-widget__block--week">
              <p class="platinum-widget__label">Platinum Rate: </span>Pt900</p>
              <p class="platinum-widget__price">
                <span class="platinum-unit"></span>{{ section.settings.rate_avg -}}
                <span class="platinum-widget__unit">/1 Kg</span>
              </p>
            </div>
            <p class="platinum-widget__date" id="rate-today-date"></p>
          </div>

          <!-- BACK FACE (new flip content) -->
          <div class="platinum-flip-back">
            <div class="platinum-flip-back__image-col">
              {% if section.settings.flip_founder_image %}
                <img src="{{ section.settings.flip_founder_image | image_url: width: 200 }}" alt="{{ section.settings.flip_founder_name }}" class="platinum-flip-back__img">
              {% endif %}
              <p class="platinum-flip-back__name">{{ section.settings.flip_founder_name }}</p>
              <p class="platinum-flip-back__designation">{{ section.settings.flip_founder_designation }}</p>
            </div>
            <div class="platinum-flip-back__content-col">
              <h3 class="platinum-flip-back__title">{{ section.settings.flip_card_title }}</h3>
              <p class="platinum-flip-back__desc">{{ section.settings.flip_card_description }}</p>
              {% if section.settings.flip_card_link_label != blank %}
                <a href="{{ section.settings.flip_card_link_url }}" class="platinum-flip-back__link">{{ section.settings.flip_card_link_label }}</a>
              {% endif %}
            </div>
          </div>

        </div>
      </div>
      <div class="location-selector">
        <div class="location-dropdown">
          <label for="state">State</label>
          <select id="state" name="state">
            {% assign states = 'Andaman and Nicobar Islands,Andhra Pradesh,Arunachal Pradesh,Assam,Bihar,Chandigarh,Chhattisgarh,Dadra and Nagar Haveli,Daman and Diu,Delhi,Goa,Gujarat,Haryana,Himachal Pradesh,Jammu and Kashmir,Jharkhand,Karnataka,Kerala,Lakshadweep,Madhya Pradesh,Maharashtra,Manipur,Meghalaya,Mizoram,Nagaland,Odisha,Puducherry,Punjab,Rajasthan,Sikkim,Tamil Nadu,Telangana,Tripura,Uttar Pradesh,Uttarakhand,West Bengal'
              | split: ','
            %}
            {% assign current_state = page.metafields.custom.state_name %}
            {% for state in states %}
              {% assign state_value = state | downcase | replace: ' ', '-' %}
              {% assign state_selected = false %}
              {% if current_state == state or current_state == state_value %}
                {% assign state_selected = true %}
              {% endif %}

              <option
                value="{{ state_value }}"
                {% if state_selected %}
                  selected
                {% endif %}
              >
                {{ state }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="location-dropdown city-dropdown">
          <label for="city">City</label>
          <select id="city" name="city">
            {% assign current_city = page.metafields.custom.city_name %}
          </select>
        </div>
