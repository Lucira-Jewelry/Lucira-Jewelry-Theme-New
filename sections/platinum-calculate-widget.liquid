<div class="platinum-calc-section">
  <div class="page-width">
    <h1 class="platinum-calc__heading">Platinum Rate Today in {{ page.metafields.custom.city_name }}</h1>
  </div>
  <div class="gst-main page-width">
    <div class="platinum-calc__container">
      <p class="platinum-calc__label">Choose Purity</p>

      <div class="platinum-calc__karat-options">
        <button class="platinum-calc__karat">Pt900</button>
        <button class="platinum-calc__karat platinum-calc__karat--active">Pt950</button>
      </div>

      <div class="platinum-calc__inputs">
        <div class="platinum-calc__input-group">
          <label for="weightInput" class="platinum-calc__input-label">In Grams</label>
          <input type="number" id="weightInput" placeholder="Enter Weight" value="10" class="platinum-calc__input">
        </div>

        <div class="platinum-calc__input-group">
          <label for="platinumRate" class="platinum-calc__input-label">
            <span class="platinum-calc__label--desktop">Today's Standard Rate of Pt950 Platinum</span>
            <span class="platinum-calc__label--mobile">Today's Pt950 Platinum Rate</span>
          </label>
          <div
            id="platinumRate"
            class="platinum-calc__rate-display"
            data-base="{{ section.settings.rate_today | remove: '₹' | remove: ',' | strip }}"
          ></div>
        </div>
      </div>

      <button class="platinum-calc__button">CALCULATE</button>
      {% if page.handle == 'gst-calculator' %}
        <div class="gst-toggle-container">
          <button class="gst-button excluding-gst">Excluding GST</button>
          <button class="gst-button including-gst active">Including GST</button>
        </div>
      {% endif %}
      <div id="platinumCalcResult" class="platinum-calc__rate-display" style="margin-top: 15px; display:none;">
        <span>Estimated Value: </span><span id="platinumValueOutput"></span>
      </div>

      <p class="platinum-calc__note">*This value is not the final value as Platinum Rate might change*</p>
    </div>
  </div>
</div>

<div class="investment-section">
  <div class="">
    <div class="investment-section__container">
      <!-- Left Column -->
      <div class="investment-section__container">
        <div class="investment-section__column investment-section__left" style="width:fit-content">
          <h2 class="investment-section__heading">{{ section.settings.investment_heading }}</h2>
          <div class="investment-section__description">
            {{ section.settings.investment_description }}
          </div>
        </div>

        <div class="investment-section__column investment-section__right">
          <h3 class="investment-section__toc-heading">Table of Contents</h3>
          {{ section.settings.investment_quick_links }}
        </div>
      </div>
    </div>
  </div>
</div>
<div class="platinum-table-v2-section">
  <div class="page-width">
    <h2 class="platinum-table-v2-title" id="platinum-price-breakdown-weight">GST PRICE BREAKDOWN BY PLATINUM WEIGHT</h2>
    <div class="platinum-table-v2-wrapper">
      <table class="platinum-table-v2">
        <thead>
          <tr>
            <th>PURITY</th>
            <th>1GM</th>
            <th>5GM</th>
            <th>10GM</th>
            <th>100GM</th>
          </tr>
        </thead>
        <tbody>
          {%- assign base_950 = section.settings.rate_today | remove: '₹' | remove: ',' | strip | plus: 0 -%}
          {%- assign rate_per_gram = base_950 | divided_by: 10.0 -%}
          {%- assign purities = '950,900' | split: ',' -%}
          {%- assign weights = '1,5,10,100' | split: ',' -%}

          {%- for purity in purities -%}
            {%- assign purity_factor = purity | plus: 0 | divided_by: 950.0 -%}
            <tr>
              <td>Pt{{ purity }}</td>
              {%- for w in weights -%}
                {%- assign price = rate_per_gram | times: w | times: purity_factor -%}
                <td>₹{{ price | round }}</td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="platinum-rate-rise-and-fall">
  <div class="page-width">
    <div class="information-content-wrapper">
      <h2>Platinum Rate Today in {{ page.metafields.custom.city_name }} – [current_date]</h2>
      <div id="platinum-rise" style="display:none">
        <h3>Platinum Rate Rises</h3>
        <p>
          In {{ page.metafields.custom.city_name }} on [current_date], Pt950 platinum is priced at [platinum_rate_950_10gm]
          per 10 grams, while Pt900 platinum stands at [platinum_rate_900_10gm] per 10 grams.
        </p>
      </div>

      <div id="platinum-fall" style="display:none">
        <h3>Platinum Rate Falls</h3>
        <p>
          In {{ page.metafields.custom.city_name }} on [current_date], Pt950 platinum is available at
          [platinum_rate_950_10gm] per 10 grams, with Pt900 platinum priced at [platinum_rate_900_10gm] per 10 grams.
        </p>
      </div>

      <div id="platinum-stable" style="display:none">
        <h3>Platinum Rate Remains Stable</h3>
        <p>
          In {{ page.metafields.custom.city_name }} on [current_date], platinum prices remain steady with Pt950 at
          [platinum_rate_950_10gm] per 10 grams and Pt900 at [platinum_rate_900_10gm] per 10 grams.
        </p>
      </div>
    </div>
  </div>
</div>

