      min-height: 320px;
    }

    .platinum-rate-page__section-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    .platinum-rate-page__hero {
      padding-top: 2rem;
    }

    .platinum-rate-page__band {
