  .platinum-rate-page__band {
    padding: 3.5rem 0;
  }

  .platinum-rate-page__band--subtle {
    background: #fafbfb;
    border-top: 1px solid rgba(25, 25, 25, 0.06);
    border-bottom: 1px solid rgba(25, 25, 25, 0.06);
  }

  .platinum-rate-page__band--table {
    background: #fafafa;
    border-top: 1px solid rgba(25, 25, 25, 0.06);
    border-bottom: 1px solid rgba(25, 25, 25, 0.06);
  }

  .platinum-rate-page__band--faq {
    background: #fafafa;
    border-top: 1px solid rgba(25, 25, 25, 0.06);
    border-bottom: 1px solid rgba(25, 25, 25, 0.06);
