    font-size: 0.9rem;
    color: rgba(25, 25, 25, 0.62);
  }

  .platinum-rate-page__hero-media {
    min-height: 100%;
  }

  .platinum-rate-page__hero-image,
  .platinum-rate-page__hero-fallback {
    display: block;
