  .platinum-rate-page__change--up { color: #2a7a2a; font-weight: 600; }
  .platinum-rate-page__change--down { color: #c0392b; font-weight: 600; }

  @media screen and (max-width: 990px) {
    .platinum-rate-page__hero-grid {
