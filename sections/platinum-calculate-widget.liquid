{% liquid
  assign city = page.metafields.custom.platinum_rate_city.value
  assign city_slug = ''
  if city != blank and city.slug != blank
    assign city_slug = city.slug
  elsif page.metafields.custom.city_name != blank
    assign city_slug = page.metafields.custom.city_name | handleize
  elsif page.handle contains '-platinum-rate-today'
    assign city_slug = page.handle | remove: '-platinum-rate-today'
  elsif page.handle contains '-platinum-rate'
    assign city_slug = page.handle | remove: '-platinum-rate'
  endif
  if city == blank and city_slug != blank
    assign city = shop.metaobjects.platinum_rate_city.values | where: 'slug', city_slug | first
  endif
  if city == blank and page.metafields.custom.city.value and page.metafields.custom.city.value.hero_title != blank
    assign city = page.metafields.custom.city.value
  endif
  assign global_rates = shop.metaobjects.platinum_rates_global['platinum-rates']
  if global_rates == blank
    assign global_rates = shop.metaobjects.platinum_rates_global.values | first
  endif
  assign city_name = city.city_name | default: page.title | default: 'Platinum Rate'
  assign city_state = city.state | default: ''
  assign nearby_city = city.nearby_city_name | default: ''
  assign nearby_city_note = city.nearby_city_note | default: ''
  assign hero_title = city.hero_title
  if hero_title == blank
    assign hero_title = "Today's Platinum Rate in " | append: city_name
  endif
  assign hero_subtitle = city.hero_subtitle | default: 'Live platinum prices'
  assign hero_description = city.hero_description
  assign city_intro = city.city_intro
  assign hero_image = city.hero_image.value | default: city.hero_image
  assign rate_950 = global_rates.rate_950 | plus: 0
  assign rate_900 = global_rates.rate_900 | plus: 0
  assign updated_at = global_rates.updated_at
  assign rate_950_display = rate_950 | round
  assign rate_900_display = rate_900 | round
  assign rate_950_8g = rate_950 | times: 8 | round
  assign rate_950_10g = rate_950 | times: 10 | round
  assign rate_950_100g = rate_950 | times: 100 | round
  assign rate_900_8g = rate_900 | times: 8 | round
  assign rate_900_10g = rate_900 | times: 10 | round
  assign rate_900_100g = rate_900 | times: 100 | round
  assign faq_list = city.faq.value
  if faq_list == blank
    assign faq_list = city.faq_reference.value
  endif
  assign content_blocks = city.content_blocks.value
  if content_blocks == blank
    assign content_blocks = city.content_block_reference.value
  endif
  assign table_blocks = city.table_reference.value
  if table_blocks == blank
    assign table_blocks = city.tables.value
  endif
  assign platinum_purity_block = content_blocks | where: 'slug', 'platinum-purity' | first
  assign hallmark_block = content_blocks | where: 'slug', 'hallmark-guide' | first
  assign buying_block = content_blocks | where: 'slug', 'buying-guide' | first
  assign investment_block = content_blocks | where: 'slug', 'investment-guide' | first
  assign factors_block = content_blocks | where: 'slug', 'factors-affecting-platinum-prices' | first
  assign festival_block = content_blocks | where: 'slug', 'festival-calendar' | first
  assign market_block = content_blocks | where: 'slug', 'market-guide' | first
  assign today_vs_yesterday_table = table_blocks | where: 'table_slug', 'today-vs-yesterday' | first
  assign weekly_trend_table = table_blocks | where: 'table_slug', 'weekly-trend' | first
  assign monthly_trend_table = table_blocks | where: 'table_slug', 'monthly-trend' | first
  assign historic_rate_table = table_blocks | where: 'table_slug', 'historic-rate' | first
  assign forecast_table = table_blocks | where: 'table_slug', 'forecast-table' | first
  assign city_comparison_table = table_blocks | where: 'table_slug', 'city-comparison' | first
  assign faq_json = ''
  if faq_list != blank
    for faq in faq_list
      if faq != blank
        capture faq_entry
          echo '{"@type":"Question","name":' | append: faq.question | strip_html | json | append: ',"acceptedAnswer":{"@type":"Answer","text":' | append: faq.answer | strip_html | json | append: '}}'
        endcapture
        if faq_json == blank
          assign faq_json = faq_entry | strip
        else
          assign faq_json = faq_json | append: ',' | append: faq_entry | strip
        endif
      endif
    endfor
  endif
%}
{% if faq_json != blank %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_json }}]}</script>{% endif %}
<section class="platinum-rate-page">
{% if city == blank %}
  <div class="page-width platinum-rate-page__empty"><h1>Platinum Rate Page</h1><p>Connect a platinum_rate_city metaobject to this page via the custom.platinum_rate_city metafield.</p></div>
{% else %}
  <div class="platinum-rate-page__hero"><div class="page-width platinum-rate-page__hero-grid">
    <div class="platinum-rate-page__hero-copy">
      <p class="platinum-rate-page__eyebrow">{{ hero_subtitle }}{% if city_state != blank %} <span class="platinum-rate-page__eyebrow-sep">|</span> {{ city_state }}{% endif %}</p>
      <h1 class="platinum-rate-page__title">{{ hero_title }}</h1>
      {% if hero_description != blank %}<div class="platinum-rate-page__richtext">{{ hero_description | metafield_tag }}</div>{% endif %}
      {% if city_intro != blank %}<div class="platinum-rate-page__intro">{{ city_intro | metafield_tag }}</div>{% endif %}
        <div class="platinum-rate-page__aeo-block">
          <p class="platinum-rate-page__aeo-meta">Updated {{ updated_at | date: '%d %B %Y' }} &nbsp;|&nbsp; Source: MCX / Multi Commodity Exchange &nbsp;|&nbsp; City: {{ city_name }}{% if city_state != blank %}, {{ city_state }}{% endif %}</p>
          <details class="platinum-rate-page__aeo-item" open>
            <summary class="platinum-rate-page__aeo-question">What is today's platinum rate in {{ city_name }}?</summary>
            <div class="platinum-rate-page__aeo-answer">
              <p>Today's platinum rate in {{ city_name }} is <strong>&#8377;{{ rate_950_display }} per gram for Pt950 platinum</strong> and <strong>&#8377;{{ rate_900_display }} per gram for Pt900 platinum</strong>. The 10 gram rate for Pt950 is &#8377;{{ rate_950_10g }} and for Pt900 is &#8377;{{ rate_900_10g }}. Prices are updated daily based on MCX and international bullion rates.</p>
            </div>
          </details>
        </div>
      <div class="platinum-rate-page__hero-stats">
        <div class="platinum-rate-page__stat"><span class="platinum-rate-page__stat-label">Pt950</span><span class="platinum-rate-page__stat-value">&#8377;{{ rate_950_display }}</span></div>
        <div class="platinum-rate-page__stat"><span class="platinum-rate-page__stat-label">Pt900</span><span class="platinum-rate-page__stat-value">&#8377;{{ rate_900_display }}</span></div>
      </div>
      {% if updated_at != blank %}<p class="platinum-rate-page__updated">Updated {{ updated_at | date: '%d %B %Y' }}</p>{% endif %}
    </div>
    <div class="platinum-rate-page__hero-media">
      {% if hero_image != blank %}<img class="platinum-rate-page__hero-image" src="{{ hero_image | image_url: width: 1400 }}" alt="{{ city_name | escape }}" loading="eager" width="1400" height="1050">
      {% else %}<div class="platinum-rate-page__hero-fallback"><span>{{ city_name }}</span></div>{% endif %}
    </div>
  </div></div>

  <div class="platinum-rate-page__band"><div class="page-width">
    <div class="platinum-rate-page__section-head">
      <h2>Today's Platinum Rate in {{ city_name }} at a Glance</h2>
      <p>Updated {{ updated_at | date: '%d %B %Y' }} &nbsp;|&nbsp; All prices include 3% GST &nbsp;|&nbsp; Making charges are additional</p>
    </div>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Platinum Type</th><th scope="col">Per Gram</th><th scope="col">Per 8g</th><th scope="col">Per 10g</th><th scope="col">Per 100g</th></tr></thead>
      <tbody>
        <tr><th scope="row">Pt950 (95%)</th><td>&#8377;{{ rate_950_display }}</td><td>&#8377;{{ rate_950_8g }}</td><td>&#8377;{{ rate_950_10g }}</td><td>&#8377;{{ rate_950_100g }}</td></tr>
        <tr><th scope="row">Pt900 (90%)</th><td>&#8377;{{ rate_900_display }}</td><td>&#8377;{{ rate_900_8g }}</td><td>&#8377;{{ rate_900_10g }}</td><td>&#8377;{{ rate_900_100g }}</td></tr>
      </tbody>
    </table></div>
    <p class="platinum-rate-page__table-note">Prices shown are indicative base rates. Actual jewellery prices will include making charges, GST, and stone setting costs. Platinum is denser than gold, so a platinum ring of the same design typically weighs more — and costs more in making charges — than an equivalent gold ring.</p>
  </div></div>

  {% assign history_all = shop.metaobjects.platinum_rate_history.values %}
  {% assign history_today = nil %}
  {% assign found_yesterday = 0 %}
  {% assign y_950 = 0 %}
  {% assign y_900 = 0 %}
  {% assign today_date = '' %}
  {% for entry in history_all %}
    {% if entry.is_current_rate == true %}
      {% assign history_today = entry %}
      {% assign today_date = entry.rate_date %}
    {% endif %}
  {% endfor %}
  {% if history_today == blank %}
    {% assign history_today = history_all | first %}
    {% assign today_date = history_all.first.rate_date %}
  {% endif %}
  {% for entry in history_all %}
    {% if found_yesterday == 0 %}
      {% assign this_date = entry.rate_date %}
      {% if this_date == today_date %}
      {% else %}
        {% assign y_950 = entry.rate_950 | plus: 0 | round %}
        {% assign y_900 = entry.rate_900 | plus: 0 | round %}
        {% assign found_yesterday = 1 %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% assign diff_950 = rate_950_display | minus: y_950 %}
  {% assign diff_900 = rate_900_display | minus: y_900 %}

  <div class="platinum-rate-page__band platinum-rate-page__band--subtle"><div class="page-width platinum-rate-page__copy-block" id="today-vs-yesterday">
    <h2>Today vs Yesterday — Platinum Rate Change in {{ city_name }}</h2>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Purity</th><th scope="col">Today (&#8377;/g)</th><th scope="col">Yesterday (&#8377;/g)</th><th scope="col">Change</th></tr></thead>
      <tbody>
        <tr>
          <th scope="row">Pt950</th>
          <td>&#8377;{{ rate_950_display }}</td>
          <td>{% if y_950 > 0 %}&#8377;{{ y_950 }}{% else %}&#8212;{% endif %}</td>
          <td>{% if y_950 > 0 %}{% if diff_950 > 0 %}<span class="platinum-rate-page__change platinum-rate-page__change--up">&#9650; &#8377;{{ diff_950 }}</span>{% elsif diff_950 < 0 %}<span class="platinum-rate-page__change platinum-rate-page__change--down">&#9660; &#8377;{{ diff_950 | abs }}</span>{% else %}<span>&#8212; No change</span>{% endif %}{% else %}&#8212;{% endif %}</td>
        </tr>
        <tr>
          <th scope="row">Pt900</th>
          <td>&#8377;{{ rate_900_display }}</td>
          <td>{% if y_900 > 0 %}&#8377;{{ y_900 }}{% else %}&#8212;{% endif %}</td>
          <td>{% if y_900 > 0 %}{% if diff_900 > 0 %}<span class="platinum-rate-page__change platinum-rate-page__change--up">&#9650; &#8377;{{ diff_900 }}</span>{% elsif diff_900 < 0 %}<span class="platinum-rate-page__change platinum-rate-page__change--down">&#9660; &#8377;{{ diff_900 | abs }}</span>{% else %}<span>&#8212; No change</span>{% endif %}{% else %}&#8212;{% endif %}</td>
        </tr>
      </tbody>
    </table></div>
  </div></div>

  {% if platinum_purity_block != blank %}
  <div class="platinum-rate-page__band"><div class="page-width platinum-rate-page__copy-block" id="platinum-purity">
    <h2>{{ platinum_purity_block.heading | default: platinum_purity_block.title }}</h2>
    <div class="platinum-rate-page__richtext">{{ platinum_purity_block.content | metafield_tag }}</div>
  </div></div>
  {% endif %}

  {% assign t950 = 'Pt950 Platinum Rate in ' | append: city_name | append: ' Today' %}
  {% assign t900 = 'Pt900 Platinum Rate in ' | append: city_name | append: ' Today' %}
  {% assign c950 = 'Pt950 Platinum Price in ' | append: city_name %}
  {% assign c900 = 'Pt900 Platinum Price in ' | append: city_name %}
  {% render 'platinum-rate-weight-table', table_id: '950-rate-table', table_title: t950, table_description: 'Pt950 (95% pure platinum) is the standard used for platinum jewellery in India, alloyed with metals like ruthenium or cobalt for strength and workability.', rate_value: rate_950, row_labels: '1 gram|2 grams|5 grams|8 grams|10 grams|20 grams|50 grams|100 grams', row_multipliers: '1|2|5|8|10|20|50|100', row_suffixes: '| | | | | | |', column_label: c950 %}
  {% render 'platinum-rate-weight-table', table_id: '900-rate-table', table_title: t900, table_description: 'Pt900 (90% pure platinum) is a slightly less pure alloy, occasionally used for rings and bands where added hardness is preferred.', rate_value: rate_900, row_labels: '1 gram|2 grams|5 grams|8 grams|10 grams|20 grams|50 grams|100 grams', row_multipliers: '1|2|5|8|10|20|50|100', row_suffixes: '| | | | | | |', column_label: c900 %}

  <div class="platinum-rate-page__band"><div class="page-width platinum-rate-page__copy-block" id="platinum-purity-comparison">
    <h2>Platinum Purity Comparison — {{ city_name }} Buying Guide</h2>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Purity</th><th scope="col">Fineness</th><th scope="col">Hallmark</th><th scope="col">Best For</th><th scope="col">Relative Price</th></tr></thead>
      <tbody>
        <tr><th scope="row">Pt950</th><td>95%</td><td>950</td><td>Engagement rings, wedding bands, fine jewellery</td><td>Higher</td></tr>
        <tr><th scope="row">Pt900</th><td>90%</td><td>900</td><td>Rings requiring extra durability</td><td>Slightly lower (alloy content)</td></tr>
      </tbody>
    </table></div>
  </div></div>

  {% if hallmark_block != blank %}
  <div class="platinum-rate-page__band"><div class="page-width platinum-rate-page__copy-block" id="hallmark-guide">
    <h2>{{ hallmark_block.heading | default: hallmark_block.title }}</h2>
    <div class="platinum-rate-page__richtext">{{ hallmark_block.content | metafield_tag }}</div>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Hallmark Code</th><th scope="col">Purity</th><th scope="col">Usage</th></tr></thead>
      <tbody>
        <tr><th scope="row">950</th><td>95%</td><td>Most platinum jewellery sold in {{ city_name }}</td></tr>
        <tr><th scope="row">900</th><td>90%</td><td>Occasionally used for rings and bands</td></tr>
      </tbody>
    </table></div>
    <p class="platinum-rate-page__table-note">BIS platinum hallmarking (Pt950) exists but is less universally enforced than gold hallmarking in India — ask your jeweller for a purity certificate, especially on higher-value pieces.</p>
  </div></div>
  {% endif %}

  {% if history_all.size > 0 %}
  <div class="platinum-rate-page__band platinum-rate-page__band--table"><div class="page-width platinum-rate-page__copy-block" id="weekly-trend">
    <h2>Weekly Platinum Price Trend in {{ city_name }} (Last 7 Days)</h2>
    <p class="platinum-rate-page__table-description">Daily platinum rates in {{ city_name }} based on MCX rates and international bullion prices.</p>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Date</th><th scope="col">Pt950 (&#8377;/g)</th><th scope="col">Pt900 (&#8377;/g)</th><th scope="col">Market Note</th></tr></thead>
      <tbody>
        {% assign weekly_count = 0 %}
        {% for entry in history_all %}
          {% if weekly_count < 7 %}
            {% assign e_950 = entry.rate_950 | plus: 0 %}
            {% assign e_900 = entry.rate_900 | plus: 0 %}
            {% assign e_date = entry.rate_date %}
            {% if e_950 > 0 or e_900 > 0 or e_date != blank %}
            <tr>
              <th scope="row">{{ e_date | date: '%d %b %Y' }}</th>
              <td>&#8377;{{ e_950 | round }}</td>
              <td>&#8377;{{ e_900 | round }}</td>
              <td>{{ entry.market_note | default: '&mdash;' }}</td>
            </tr>
            {% assign weekly_count = weekly_count | plus: 1 %}
            {% endif %}
          {% endif %}
        {% endfor %}
      </tbody>
    </table></div>
  </div></div>
  {% endif %}

  {% if history_all.size > 0 %}
  <div class="platinum-rate-page__band platinum-rate-page__band--table"><div class="page-width platinum-rate-page__copy-block" id="monthly-trend">
    <h2>Monthly Platinum Rate Trend in {{ city_name }} — Last 12 Months</h2>
    <p class="platinum-rate-page__table-description">Month-end platinum rates in {{ city_name }}. Updated as new daily entries are added.</p>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Month</th><th scope="col">Pt950 (&#8377;/g)</th><th scope="col">Pt900 (&#8377;/g)</th><th scope="col">Market Note</th></tr></thead>
      <tbody>
        {% assign seen_months = '|' %}
        {% assign month_count = 0 %}
        {% for entry in history_all %}
          {% assign entry_month_key = entry.rate_date | date: '%Y-%m' %}
          {% assign check_key = '|' | append: entry_month_key | append: '|' %}
          {% unless seen_months contains check_key %}
            {% if month_count < 12 %}
              <tr>
                <th scope="row">{{ entry.rate_date | date: '%B %Y' }}</th>
                <td>&#8377;{{ entry.rate_950 | plus: 0 | round }}</td>
                <td>&#8377;{{ entry.rate_900 | plus: 0 | round }}</td>
                <td>{{ entry.market_note | default: '&mdash;' }}</td>
              </tr>
              {% assign seen_months = seen_months | append: entry_month_key | append: '|' %}
              {% assign month_count = month_count | plus: 1 %}
            {% endif %}
          {% endunless %}
        {% endfor %}
      </tbody>
    </table></div>
  </div></div>
  {% endif %}

  {% if nearby_city != blank %}
  <div class="platinum-rate-page__band platinum-rate-page__band--subtle"><div class="page-width platinum-rate-page__copy-block" id="nearby-city-rate">
    <h2>Today's Platinum Rate in {{ nearby_city }}</h2>
    <p class="platinum-rate-page__table-description">{{ nearby_city_note | default: 'Platinum rates in ' | append: nearby_city | append: ' are the same as ' | append: city_name | append: ' — both fall under the same state jewellery association pricing.' }}</p>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Purity</th><th scope="col">Per Gram</th><th scope="col">Per 10 Gram</th><th scope="col">Notes</th></tr></thead>
      <tbody>
        <tr><th scope="row">Pt950</th><td>&#8377;{{ rate_950_display }}</td><td>&#8377;{{ rate_950_10g }}</td><td>Fine jewellery platinum</td></tr>
        <tr><th scope="row">Pt900</th><td>&#8377;{{ rate_900_display }}</td><td>&#8377;{{ rate_900_10g }}</td><td>Ring/band platinum</td></tr>
      </tbody>
    </table></div>
  </div></div>
  {% endif %}

  {% if buying_block != blank %}
  <div class="platinum-rate-page__band platinum-rate-page__band--subtle"><div class="page-width platinum-rate-page__copy-block" id="buying-guide">
    <h2>{{ buying_block.heading | default: buying_block.title }}</h2>
    <div class="platinum-rate-page__richtext">{{ buying_block.content | metafield_tag }}</div>
    <h3>How Jewellery Prices Are Calculated in {{ city_name }}</h3>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Component</th><th scope="col">Approximate Range</th><th scope="col">Notes</th></tr></thead>
      <tbody>
        <tr><th scope="row">Base Platinum Rate</th><td>MCX / international rate</td><td>Published daily — forms the base of your jewellery cost</td></tr>
        <tr><th scope="row">Making Charges</th><td>&#8377;500 – &#8377;2,500/g</td><td>Higher than gold — platinum is harder to work and melts at a much higher temperature</td></tr>
        <tr><th scope="row">GST</th><td>3%</td><td>On platinum value + making charges</td></tr>
        <tr><th scope="row">Wastage / Karigar</th><td>0–8%</td><td>Platinum has higher wastage during crafting than gold</td></tr>
        <tr><th scope="row">Stone / Diamond Cost</th><td>Market rate</td><td>Additional for gemstone-set jewellery</td></tr>
        <tr><th scope="row">Hallmarking Fee</th><td>&#8377;35–&#8377;45/piece</td><td>Where BIS platinum hallmarking is applied</td></tr>
      </tbody>
    </table></div>
    <p class="platinum-rate-page__table-note">At Lucira Jewellery, our lab-grown diamond pieces are priced transparently. Platinum's density means the same design typically uses more metal by weight than an equivalent gold piece.</p>
  </div></div>
  {% endif %}

  {% if investment_block != blank %}
  <div class="platinum-rate-page__band"><div class="page-width platinum-rate-page__copy-block" id="investment-guide">
    <h2>{{ investment_block.heading | default: investment_block.title }}</h2>
    <div class="platinum-rate-page__richtext">{{ investment_block.content | metafield_tag }}</div>
    <h3>Platinum vs Other Investments — {{ city_name }} Perspective</h3>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Factor</th><th scope="col">Platinum</th><th scope="col">Gold</th><th scope="col">Fixed Deposit</th><th scope="col">SGBs</th></tr></thead>
      <tbody>
        <tr><th scope="row">Liquidity</th><td>Moderate (fewer buyers/sellers than gold)</td><td>High</td><td>Medium</td><td>High</td></tr>
        <tr><th scope="row">Industrial Demand Link</th><td>Very strong (auto catalytic converters)</td><td>Weak</td><td>None</td><td>None</td></tr>
        <tr><th scope="row">Price vs Gold</th><td>Has traded both above and below gold historically</td><td>Reference</td><td>N/A</td><td>N/A</td></tr>
        <tr><th scope="row">Risk Level</th><td>Higher (thinner market, supply concentrated in few countries)</td><td>Moderate</td><td>Low</td><td>Low</td></tr>
        <tr><th scope="row">Tax on Returns</th><td>LTCG 20%</td><td>LTCG 20%</td><td>Taxable</td><td>Tax-free</td></tr>
        <tr><th scope="row">Jewellery Utility</th><td>Yes — popular for rings/bands</td><td>Yes</td><td>No</td><td>No</td></tr>
      </tbody>
    </table></div>
    <p class="platinum-rate-page__table-note">Platinum's price is more exposed to industrial cycles (especially automotive demand) than gold, and its market is thinner — meaning prices can move more sharply on supply news from major producing countries. This table is for general information only and is not personalised financial advice.</p>
  </div></div>
  {% endif %}

  {% if factors_block != blank %}
  <div class="platinum-rate-page__band"><div class="page-width platinum-rate-page__copy-block" id="factors-affecting-platinum-prices">
    <h2>{{ factors_block.heading | default: factors_block.title }}</h2>
    <div class="platinum-rate-page__richtext">{{ factors_block.content | metafield_tag }}</div>
    <h3>Key Factors — How They Influence the {{ city_name }} Platinum Rate</h3>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Factor</th><th scope="col">How It Influences {{ city_name }} Platinum Rate</th></tr></thead>
      <tbody>
        <tr><th scope="row">International Spot Price</th><td>Platinum trades on the NYMEX/LPPM and is priced in USD per troy ounce globally.</td></tr>
        <tr><th scope="row">Automotive/Industrial Demand</th><td>A large share of platinum demand comes from catalytic converters in diesel vehicles — this is a much bigger price driver than for gold.</td></tr>
        <tr><th scope="row">Mine Supply Concentration</th><td>Most platinum mining is concentrated in South Africa and Russia, making supply disruptions a major price factor.</td></tr>
        <tr><th scope="row">USD-INR Exchange Rate</th><td>As platinum is imported, a weaker rupee directly raises the {{ city_name }} platinum rate.</td></tr>
        <tr><th scope="row">Import Duty</th><td>India levies import duty on platinum; budget changes affect rates immediately.</td></tr>
        <tr><th scope="row">MCX Rates</th><td>Multi Commodity Exchange futures prices serve as a daily benchmark in India.</td></tr>
        <tr><th scope="row">State Taxes &amp; Levies</th><td>{{ city_state | default: 'State' }} applies its own levies; rates may differ marginally from other states.</td></tr>
        <tr><th scope="row">GST</th><td>3% GST applies on platinum value and making charges at point of purchase.</td></tr>
        <tr><th scope="row">Bridal/Wedding Demand</th><td>Platinum is a popular choice for engagement rings and wedding bands in {{ city_name }}, adding seasonal demand around the wedding calendar.</td></tr>
      </tbody>
    </table></div>
  </div></div>
  {% endif %}

  {% if festival_block != blank %}
  <div class="platinum-rate-page__band"><div class="page-width platinum-rate-page__copy-block" id="festival-calendar">
    <h2>{{ festival_block.heading | default: festival_block.title }}</h2>
    <div class="platinum-rate-page__richtext">{{ festival_block.content | metafield_tag }}</div>
    <h3>{{ city_name }} Platinum Buying Calendar</h3>
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Month/Period</th><th scope="col">Occasion</th><th scope="col">Demand Level</th><th scope="col">Buying Note</th></tr></thead>
      <tbody>
        <tr><th scope="row">November–February</th><td>Wedding Season</td><td>High</td><td>Platinum bands and engagement rings peak; plan purchases 30–60 days in advance</td></tr>
        <tr><th scope="row">October/November</th><td>Dhanteras</td><td>Moderate</td><td>Some buyers extend gold-buying tradition to platinum jewellery</td></tr>
        <tr><th scope="row">April/May</th><td>Akshaya Tritiya</td><td>Moderate</td><td>Considered auspicious; platinum rings are a growing gifting choice</td></tr>
        <tr><th scope="row">June–August (Monsoon)</th><td>Slow Season</td><td>Low</td><td>Historically quieter buying window</td></tr>
      </tbody>
    </table></div>
    <p class="platinum-rate-page__table-note">Unlike gold, platinum demand in India is driven more by bridal jewellery timing than by festival calendars.</p>
  </div></div>
  {% endif %}

  {% if market_block != blank %}
  <div class="platinum-rate-page__band platinum-rate-page__band--subtle"><div class="page-width platinum-rate-page__copy-block" id="market-guide">
    <h2>{{ market_block.heading | default: market_block.title }}</h2>
    <div class="platinum-rate-page__richtext">{{ market_block.content | metafield_tag }}</div>
  </div></div>
  {% endif %}

  {% if historic_rate_table != blank %}
  <div class="platinum-rate-page__band platinum-rate-page__band--table"><div class="page-width platinum-rate-page__copy-block" id="historic-rate">
    <h2>{{ historic_rate_table.table_title }}</h2>
    {% if historic_rate_table.table_description != blank %}<p class="platinum-rate-page__table-description">{{ historic_rate_table.table_description }}</p>{% endif %}
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Month</th><th scope="col">Pt950</th><th scope="col">Pt900</th></tr></thead>
      <tbody><tr><th scope="row">Current</th><td>&#8377;{{ rate_950_display }}</td><td>&#8377;{{ rate_900_display }}</td></tr></tbody>
    </table></div>
  </div></div>
  {% endif %}

  {% if forecast_table != blank %}
  <div class="platinum-rate-page__band platinum-rate-page__band--table"><div class="page-width platinum-rate-page__copy-block" id="forecast-table">
    <h2>{{ forecast_table.table_title }}</h2>
    {% if forecast_table.table_description != blank %}<p class="platinum-rate-page__table-description">{{ forecast_table.table_description }}</p>{% endif %}
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">Scenario</th><th scope="col">Pt950</th><th scope="col">Pt900</th><th scope="col">Note</th></tr></thead>
      <tbody><tr><th scope="row">Today</th><td>&#8377;{{ rate_950_display }}</td><td>&#8377;{{ rate_900_display }}</td><td>Live rate</td></tr></tbody>
    </table></div>
  </div></div>
  {% endif %}

  {% if city_comparison_table != blank %}
  <div class="platinum-rate-page__band platinum-rate-page__band--table"><div class="page-width platinum-rate-page__copy-block" id="city-comparison">
    <h2>{{ city_comparison_table.table_title }}</h2>
    {% if city_comparison_table.table_description != blank %}<p class="platinum-rate-page__table-description">{{ city_comparison_table.table_description }}</p>{% endif %}
    <div class="platinum-rate-page__table-wrap"><table class="platinum-rate-page__table">
      <thead><tr><th scope="col">City</th><th scope="col">Pt950</th><th scope="col">Pt900</th><th scope="col">Note</th></tr></thead>
      <tbody><tr><th scope="row">{{ city_name }}</th><td>&#8377;{{ rate_950_display }}</td><td>&#8377;{{ rate_900_display }}</td><td>Current market</td></tr></tbody>
    </table></div>
  </div></div>
  {% endif %}

  {% if faq_list != blank %}
  <div class="platinum-rate-page__band platinum-rate-page__band--faq"><div class="page-width platinum-rate-page__copy-block" id="faq">
    <h2>Frequently Asked Questions — Platinum Rate in {{ city_name }}</h2>
    <div class="platinum-rate-page__faq-list">
      {% for faq in faq_list %}{% if faq != blank %}
        <details class="platinum-rate-page__faq-item">
          <summary class="platinum-rate-page__faq-question">{{ faq.question }}</summary>
          <div class="platinum-rate-page__faq-answer">{{ faq.answer | metafield_tag }}</div>
        </details>
      {% endif %}{% endfor %}
    </div>
  </div></div>
  {% endif %}

{% endif %}
</section>

<style>
