<script>
  $(document).ready(function () {
    function calculatePlatinumValue() {
      const weight = parseFloat($('#weightInput').val());
      const resultContainer = $('#platinumCalcResult');

      if (isNaN(weight) || weight <= 0) {
        resultContainer.hide();
        return;
      }

      const baseRate = parseFloat($('#platinumRate').data('base'));
      const activePurity = $('.platinum-calc__karat.platinum-calc__karat--active').text().replace('Pt', '').trim();

      let currentRate;
      if (activePurity === '950') {
        currentRate = baseRate / 10;
      } else {
        currentRate = (baseRate / 10) * (parseInt(activePurity) / 950);
      }

      const value = weight * currentRate;
      $('#platinumValueOutput').text('₹' + value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
      resultContainer.show();
    }

    $('.platinum-calc__karat').on('click', function () {
      $('.platinum-calc__karat').removeClass('platinum-calc__karat--active');
      $(this).addClass('platinum-calc__karat--active');
      calculatePlatinumValue();
    });

    $('#weightInput').val(10);
    calculatePlatinumValue();

    $('.platinum-calc__button').on('click', calculatePlatinumValue);
  });
</script>
