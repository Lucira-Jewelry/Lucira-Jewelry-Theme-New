    color: #191919;
  }

  .platinum-rate-page__richtext,
  .platinum-rate-page__intro {
    margin-top: 1rem;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .platinum-rate-page__intro {
    color: rgba(25, 25, 25, 0.8);
  }

  .platinum-rate-page__richtext p {
    margin: 0 0 1.25rem;
    line-height: 1.75;
    color: rgba(25, 25, 25, 0.85);
  }

  .platinum-rate-page__richtext p:last-child {
    margin-bottom: 0;
  }

  .platinum-rate-page__richtext h3,
  .platinum-rate-page__richtext h4 {
    margin: 2rem 0 1rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: #191919;
  }

  .platinum-rate-page__richtext h3:first-child,
  .platinum-rate-page__richtext h4:first-child {
    margin-top: 0;
  }

  .platinum-rate-page__richtext ul,
  .platinum-rate-page__richtext ol {
    margin: 1.5rem 0;
    padding-left: 0;
    list-style: none;
  }

  .platinum-rate-page__richtext ol {
    counter-reset: list-item;
  }

  .platinum-rate-page__richtext ul li,
  .platinum-rate-page__richtext ol li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
    color: rgba(25, 25, 25, 0.85);
