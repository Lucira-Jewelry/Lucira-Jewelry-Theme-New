  .platinum-rate-page__section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .platinum-rate-page__section-head h2,
  .platinum-rate-page__copy-block h2 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
    line-height: 1.2;
    font-weight: 600;
    color: #191919;
  }

  .platinum-rate-page__section-head p,
  .platinum-rate-page__table-description {
    margin: 0;
