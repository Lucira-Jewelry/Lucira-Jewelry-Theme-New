    border-left: 3px solid #5a6169;
  }

  .platinum-rate-page__richtext ul li::before {
    content: "•";
    color: #5a6169;
    font-weight: bold;
    margin-right: 0.75rem;
  }

  .platinum-rate-page__richtext ol li {
    counter-increment: list-item;
  }

  .platinum-rate-page__richtext ol li::before {
    content: counter(list-item) ".";
    color: #5a6169;
    font-weight: bold;
    margin-right: 0.75rem;
  }

  .platinum-rate-page__richtext a {
    color: #5a6169;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .platinum-rate-page__richtext a:hover {
    color: #454b52;
  }

  .platinum-rate-page__richtext strong,
  .platinum-rate-page__richtext b {
    font-weight: 600;
    color: #191919;
  }

  .platinum-rate-page__richtext em,
  .platinum-rate-page__richtext i {
    font-style: italic;
  }

  .platinum-rate-page__hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
    max-width: 420px;
  }

  .platinum-rate-page__stat {
    padding: 0.9rem 1rem;
    border: 1px solid rgba(25, 25, 25, 0.12);
    border-radius: 8px;
    background: #fff;
  }

  .platinum-rate-page__stat-label {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    color: rgba(25, 25, 25, 0.58);
  }

  .platinum-rate-page__stat-value {
    display: block;
    margin-top: 0.35rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .platinum-rate-page__updated {
