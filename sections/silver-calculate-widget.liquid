<script>
  $(document).ready(function () {
    function calculateSilverValue() {
      const weight = parseFloat($('#weightInput').val());
      const resultContainer = $('#silverCalcResult');

      if (isNaN(weight) || weight <= 0) {
        resultContainer.hide();
        return;
      }

      const baseRate = parseFloat($('#silverRate').data('base'));
      const activePurity = $('.silver-calc__karat.silver-calc__karat--active').text().trim();

      let currentRate;
      if (activePurity === '999') {
        currentRate = baseRate / 10;
      } else {
        currentRate = (baseRate / 10) * (parseInt(activePurity) / 999);
      }

      const value = weight * currentRate;
      $('#silverValueOutput').text('₹' + value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
      resultContainer.show();
    }

    $('.silver-calc__karat').on('click', function () {
      $('.silver-calc__karat').removeClass('silver-calc__karat--active');
      $(this).addClass('silver-calc__karat--active');
      calculateSilverValue();
    });

    $('#weightInput').val(10);
    calculateSilverValue();

    $('.silver-calc__button').on('click', calculateSilverValue);
  });
</script>
