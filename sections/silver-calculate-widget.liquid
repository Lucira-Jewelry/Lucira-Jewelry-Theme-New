    width: 70px;
    height: 70px;
  }
  .silver-flip-back__title {
    font-size: 12px;
    margin-bottom:4px;
  }
  .silver-flip-back__desc {
        font-size: 9px;
        line-height: 1.2;
        letter-spacing: 1px;
      margin-bottom:0;
      }
}

