    grid-template-columns: repeat(2, 1fr);
    row-gap: 10px;column-gap:40px; }

   /* ── Flip CTA ── */
.silver-rate-flip-cta {
  background: transparent;
  border: none;
  color: #fff;
  font-family: 'Futura Std', sans-serif;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 1px;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
  padding: 0;
  margin-bottom: 10px;
  display: block;
  text-align: right;
  width: 100%;
}

/* ── Flip container ── */
.silver-flip-wrapper {
  perspective: 1200px;
}

.silver-flip-inner {
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.65s cubic-bezier(0.45, 0.05, 0.55, 0.95);
}

.silver-flip-inner.is-flipped {
  transform: rotateX(180deg);
}

/* ── Shared face styles ── */
.silver-flip-front,
.silver-flip-back {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 0 10px rgba(0,0,0,.15);
}

/* ── Front face ── */
.silver-flip-front {
  position: relative;
  z-index: 2;
}

/* ── Back face ── */
.silver-flip-back {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform: rotateX(180deg);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16px;
  gap: 16px;
  box-sizing: border-box;
}

.silver-flip-back__image-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.silver-flip-back__img {
  width: 100px;
  height: 108px;
  object-fit: cover;
  border-radius: 8px;
  display: block;
}

.silver-flip-back__name {
  font-family: 'Futura Std', sans-serif;
  margin-bottom:4px;
  font-weight: 500;
  color: #1a1a1a;
  margin: 0 0 2px 0;
  line-height: 0.5;
    margin-top: 8px;
    font-size:12px;
}

.silver-flip-back__designation {
  font-family: 'Futura Std', sans-serif;
  font-size: 9px;
  color: #666;
  margin: 0;
}

.silver-flip-back__content-col {
  flex: 1;
  text-align: left;
}

.silver-flip-back__title {
  font-family: 'Futura Std', sans-serif;
  font-size: 16px;
  font-weight: 500;
  color: #1a1a1a;
  margin: 0 0 8px 0;
  line-height: 1.3;
}

.silver-flip-back__desc {
  font-family: 'Futura Std', sans-serif;
  font-size: 12px;
  color: #444;
  line-height: 1.6;
  margin: 0 0 10px 0;
}

.silver-flip-back__link {
  font-family: 'Futura Std', sans-serif;
  font-size: 12px;
  font-weight: 600;
  color: #a05a64;
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* ── Mobile overrides ── */
@media screen and (max-width: 767px) {
  .silver-flip-back {
    flex-direction: row;
    padding: 12px;
    gap: 10px;
  }
