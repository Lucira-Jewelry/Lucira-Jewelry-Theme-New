<div class="silver-calc-section">
  <div class="page-width">
    <h1 class="silver-calc__heading">Silver Rate Today in {{ page.metafields.custom.city_name }}</h1>
  </div>
  <div class="gst-main page-width">
    <div class="silver-calc__container">
      <p class="silver-calc__label">Choose Purity</p>

      <div class="silver-calc__karat-options">
        <button class="silver-calc__karat">925</button>
        <button class="silver-calc__karat silver-calc__karat--active">999</button>
      </div>

      <div class="silver-calc__inputs">
        <div class="silver-calc__input-group">
          <label for="weightInput" class="silver-calc__input-label">In Grams</label>
          <input type="number" id="weightInput" placeholder="Enter Weight" value="10" class="silver-calc__input">
        </div>

        <div class="silver-calc__input-group">
          <label for="silverRate" class="silver-calc__input-label">
            <span class="silver-calc__label--desktop">Today's Standard Rate of 999 Silver</span>
            <span class="silver-calc__label--mobile">Today's 999 Silver Rate</span>
          </label>
          <div
            id="silverRate"
            class="silver-calc__rate-display"
            data-base="{{ section.settings.rate_today | remove: '₹' | remove: ',' | strip }}"
          ></div>
        </div>
      </div>

      <button class="silver-calc__button">CALCULATE</button>
      {% if page.handle == 'gst-calculator' %}
        <div class="gst-toggle-container">
          <button class="gst-button excluding-gst">Excluding GST</button>
          <button class="gst-button including-gst active">Including GST</button>
        </div>
      {% endif %}
      <div id="silverCalcResult" class="silver-calc__rate-display" style="margin-top: 15px; display:none;">
        <span>Estimated Value: </span><span id="silverValueOutput"></span>
      </div>

      <p class="silver-calc__note">*This value is not the final value as Silver Rate might change*</p>
    </div>
  </div>
</div>

<div class="investment-section">
  <div class="">
    <div class="investment-section__container">
      <!-- Left Column -->
      <div class="investment-section__container">
        <div class="investment-section__column investment-section__left" style="width:fit-content">
          <h2 class="investment-section__heading">{{ section.settings.investment_heading }}</h2>
          <div class="investment-section__description">
            {{ section.settings.investment_description }}
          </div>
        </div>

        <div class="investment-section__column investment-section__right">
          <h3 class="investment-section__toc-heading">Table of Contents</h3>
          {{ section.settings.investment_quick_links }}
        </div>
      </div>
    </div>
  </div>
</div>
<div class="silver-table-v2-section">
  <div class="page-width">
    <h2 class="silver-table-v2-title" id="silver-price-breakdown-weight">GST PRICE BREAKDOWN BY SILVER WEIGHT</h2>
    <div class="silver-table-v2-wrapper">
      <table class="silver-table-v2">
        <thead>
          <tr>
            <th>PURITY</th>
            <th>1GM</th>
            <th>10GM</th>
            <th>100GM</th>
            <th>1KG</th>
          </tr>
        </thead>
        <tbody>
          {%- assign base_999 = section.settings.rate_today | remove: '₹' | remove: ',' | strip | plus: 0 -%}
          {%- assign rate_per_gram = base_999 | divided_by: 10.0 -%}
          {%- assign purities = '999,925' | split: ',' -%}
          {%- assign weights = '1,10,100,1000' | split: ',' -%}

          {%- for purity in purities -%}
            {%- assign purity_factor = purity | plus: 0 | divided_by: 999.0 -%}
            <tr>
              <td>{{ purity }}</td>
              {%- for w in weights -%}
                {%- assign price = rate_per_gram | times: w | times: purity_factor -%}
                <td>₹{{ price | round }}</td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="silver-rate-rise-and-fall">
  <div class="page-width">
    <div class="information-content-wrapper">
      <h2>Silver Rate Today in {{ page.metafields.custom.city_name }} – [current_date]</h2>
      <div id="silver-rise" style="display:none">
        <h3>Silver Rate Rises</h3>
        <p>
          In {{ page.metafields.custom.city_name }} on [current_date], 999 fine silver is priced at [silver_rate_999_10gm]
          per 10 grams, while 925 sterling silver stands at [silver_rate_925_10gm] per 10 grams.
        </p>
      </div>

      <div id="silver-fall" style="display:none">
        <h3>Silver Rate Falls</h3>
        <p>
          In {{ page.metafields.custom.city_name }} on [current_date], 999 fine silver is available at
          [silver_rate_999_10gm] per 10 grams, with 925 sterling silver priced at [silver_rate_925_10gm] per 10 grams.
        </p>
      </div>

      <div id="silver-stable" style="display:none">
        <h3>Silver Rate Remains Stable</h3>
        <p>
          In {{ page.metafields.custom.city_name }} on [current_date], silver prices remain steady with 999 fine silver at
          [silver_rate_999_10gm] per 10 grams and 925 sterling silver at [silver_rate_925_10gm] per 10 grams.
        </p>
      </div>
    </div>
  </div>
</div>

