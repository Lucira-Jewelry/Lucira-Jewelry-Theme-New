<div class="silver-widget-section">
  <div class="page-width">
    <div class="wrapper-silver">
      <div class="silver-cta-block" style="display:flex;">
      <h1>Todays Silver rate in {{ page.metafields.custom.city_name }}</h1>
      <button class="silver-rate-flip-cta" id="flipTrigger">Is Silver A Wise Investment?</button>
      </div>
      <!-- WRAP silver-widget__box in a flip container -->
      <div class="silver-flip-wrapper">
        <div class="silver-flip-inner" id="silverFlipInner">

          <!-- FRONT FACE (existing content) -->
          <div class="silver-flip-front silver-widget__box">
            <div class="silver-widget__block silver-widget__block--today">
              <p class="silver-widget__label">Silver Rate: </span>999 Fine</p>
              <p class="silver-widget__price">
                <span class="silver-unit"></span>{{ section.settings.rate_today -}}
                <span class="silver-widget__unit">/10 gm</span>
              </p>
            </div>
            <div class="silver-widget__divider"></div>
            <div class="silver-widget__block silver-widget__block--week">
              <p class="silver-widget__label">Silver Rate: </span>925 Sterling</p>
              <p class="silver-widget__price">
                <span class="silver-unit"></span>{{ section.settings.rate_avg -}}
                <span class="silver-widget__unit">/1 Kg</span>
              </p>
            </div>
            <p class="silver-widget__date" id="rate-today-date"></p>
          </div>

          <!-- BACK FACE (new flip content) -->
          <div class="silver-flip-back">
            <div class="silver-flip-back__image-col">
              {% if section.settings.flip_founder_image %}
                <img src="{{ section.settings.flip_founder_image | image_url: width: 200 }}" alt="{{ section.settings.flip_founder_name }}" class="silver-flip-back__img">
              {% endif %}
              <p class="silver-flip-back__name">{{ section.settings.flip_founder_name }}</p>
              <p class="silver-flip-back__designation">{{ section.settings.flip_founder_designation }}</p>
            </div>
            <div class="silver-flip-back__content-col">
              <h3 class="silver-flip-back__title">{{ section.settings.flip_card_title }}</h3>
              <p class="silver-flip-back__desc">{{ section.settings.flip_card_description }}</p>
              {% if section.settings.flip_card_link_label != blank %}
                <a href="{{ section.settings.flip_card_link_url }}" class="silver-flip-back__link">{{ section.settings.flip_card_link_label }}</a>
              {% endif %}
            </div>
          </div>

        </div>
      </div>
      <div class="location-selector">
        <div class="location-dropdown">
          <label for="state">State</label>
          <select id="state" name="state">
            {% assign states = 'Andaman and Nicobar Islands,Andhra Pradesh,Arunachal Pradesh,Assam,Bihar,Chandigarh,Chhattisgarh,Dadra and Nagar Haveli,Daman and Diu,Delhi,Goa,Gujarat,Haryana,Himachal Pradesh,Jammu and Kashmir,Jharkhand,Karnataka,Kerala,Lakshadweep,Madhya Pradesh,Maharashtra,Manipur,Meghalaya,Mizoram,Nagaland,Odisha,Puducherry,Punjab,Rajasthan,Sikkim,Tamil Nadu,Telangana,Tripura,Uttar Pradesh,Uttarakhand,West Bengal'
              | split: ','
            %}
            {% assign current_state = page.metafields.custom.state_name %}
            {% for state in states %}
              {% assign state_value = state | downcase | replace: ' ', '-' %}
              {% assign state_selected = false %}
              {% if current_state == state or current_state == state_value %}
                {% assign state_selected = true %}
              {% endif %}

              <option
                value="{{ state_value }}"
                {% if state_selected %}
                  selected
                {% endif %}
              >
                {{ state }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="location-dropdown city-dropdown">
          <label for="city">City</label>
          <select id="city" name="city">
            {% assign current_city = page.metafields.custom.city_name %}
